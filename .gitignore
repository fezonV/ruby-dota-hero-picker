# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system belong in
# Git's global ignore instead: `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`.

# Ignore Bundler and Ruby environment files.
/.bundle
/vendor/bundle
/lib/bundler/man
/.config
.rvmrc

# Ignore local environment files.
/.env*

# Ignore logs and temporary files, but keep their directories.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage, but keep its directory structure.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore generated assets, reports, packages, and documentation.
/public/assets
/coverage/
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/.yardoc/
/_yardoc/
/doc/
/rdoc/

# Ignore generated Ruby artifacts and local tool state.
*.gem
*.rbc
.byebug_history
.dat*
.repl_history
build/
*.bridgesupport

# Ignore key files for decrypting credentials and more.
/config/*.key
