<% content_for :title, "Вход — Aegis Draft" %>
<main class="auth-layout">
  <section class="form-region" aria-labelledby="form-title">
    <div class="form-wrap">
      <h1 id="form-title">Вход в аккаунт</h1>
      <p class="form-intro">Введите email и пароль.</p>
      <%= render "shared/flash" %>
      <%= form_with url: session_path do |form| %>
        <div class="form-field">
          <%= form.label :email, "Email" %>
          <%= form.email_field :email, value: @email, required: true, autocomplete: "email", placeholder: "you@example.com" %>
        </div>
        <%= render "shared/password_field", form: form, name: :password, label: "Пароль", autocomplete: "current-password", placeholder: "Введите пароль" %>
        <button class="primary" type="submit">Войти <%= render "shared/arrow" %></button>
      <% end %>
      <p class="form-bottom">Впервые здесь? <%= link_to "Создать аккаунт", new_registration_path, class: "text-link" %></p>
    </div>
  </section>
</main>
