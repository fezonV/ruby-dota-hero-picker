<% content_for :title, "Вход — Aegis Draft" %>
<% content_for :body_class, "auth-page" %>

<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="auth-title">
    <a class="auth-brand" href="<%= root_path %>" aria-label="Aegis Draft — на главную">
      <span class="auth-mark" data-controller="glyph-mark" data-action="pointermove->glyph-mark#move pointerleave->glyph-mark#leave focus->glyph-mark#burst click->glyph-mark#burst" tabindex="0" role="img" aria-label="Логотип Aegis из символов">
        <svg data-glyph-mark-target="canvas" viewBox="0 0 120 120" aria-hidden="true"></svg>
      </span>
      <span class="auth-brand-name">Aegis <span>Draft</span></span>
    </a>

    <div class="auth-heading">
      <h1 id="auth-title">С возвращением</h1>
      <p>Войдите, чтобы продолжить работу с драфтом.</p>
    </div>

    <%= form_with url: session_path, class: "auth-form" do |form| %>
      <div class="auth-field">
        <%= form.label :email, "Email" %>
        <%= form.email_field :email, value: @email, required: true, autofocus: true, autocomplete: "email", placeholder: "name@example.com" %>
      </div>

      <div class="auth-field">
        <%= form.label :password, "Пароль" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Введите пароль" %>
      </div>

      <%= form.submit "Войти", class: "auth-submit" %>
    <% end %>

    <p class="auth-switch">Впервые здесь? <%= link_to "Создать аккаунт", new_registration_path %></p>
  </section>
</main>
