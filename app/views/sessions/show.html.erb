<% content_for :title, "Аккаунт — Aegis Draft" %>
<main class="auth-layout">
  <section class="form-region" aria-labelledby="form-title">
    <div class="form-wrap">
      <%= render "shared/flash" %>
      <span class="status-badge">Твой аккаунт</span>
      <h1 id="form-title">Вы вошли в аккаунт</h1>
      <p class="account-email"><%= current_user.email %></p>
      <%= link_to root_path, class: "primary" do %>На главную <%= render "shared/arrow" %><% end %>
    </div>
  </section>
</main>
