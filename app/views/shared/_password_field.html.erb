<div class="form-field">
  <%= form.label name, label %>
  <div class="password-wrap">
    <%= form.password_field name, required: true, autocomplete: autocomplete, placeholder: placeholder, data: { sensitive_password: true } %>
    <button class="eye" type="button" aria-label="Показать <%= name == :password ? "пароль" : "повтор пароля" %>" aria-pressed="false" data-action="glyph-mark#togglePassword" data-password-id="<%= form.field_id(name) %>" data-password-label="<%= name == :password ? "пароль" : "повтор пароля" %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
    </button>
  </div>
</div>
