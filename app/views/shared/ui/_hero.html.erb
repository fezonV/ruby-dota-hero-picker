<button type="button" class="hero-option" aria-pressed="false" data-ui-kit-target="hero" data-action="ui-kit#select" data-name="<%= name %>" data-role="<%= role %>">
  <span class="hero-initial" aria-hidden="true"><%= name.first %></span>
  <span><strong><%= name %></strong><span class="component-meta"><%= role %></span></span>
  <span class="hero-choice">Выбрать</span>
</button>
