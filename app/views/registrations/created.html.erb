<% content_for :title, "Аккаунт создан — Aegis Draft" %>
<main class="auth-layout">
  <section class="form-region" aria-labelledby="form-title">
    <div class="form-wrap">
      <%= render "shared/flash" %>
      <span class="status-badge">Всё готово</span>
      <h1 id="form-title">Аккаунт создан</h1>
      <p class="form-intro">Регистрация прошла успешно. Войди в свой аккаунт, чтобы продолжить.</p>
      <%= link_to new_session_path, class: "primary" do %>Войти <%= render "shared/arrow" %><% end %>
    </div>
  </section>
</main>
