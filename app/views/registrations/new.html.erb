<% content_for :title, "Регистрация — Aegis Draft" %>
<main class="auth-layout">
  <section class="form-region" aria-labelledby="form-title">
    <div class="form-wrap">
      <h1 id="form-title">Создать аккаунт</h1>
      <p class="form-intro">Создай аккаунт для Aegis Draft.</p>
      <%= render "shared/flash" %>
      <% if @user.errors.any? %>
        <div class="feedback feedback-error" role="alert">
          <h2>Не удалось создать аккаунт</h2>
          <ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>
      <%= form_with model: @user, url: registration_path do |form| %>
        <div class="form-field">
          <%= form.label :email, "Email" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com" %>
        </div>
        <%= render "shared/password_field", form: form, name: :password, label: "Пароль", autocomplete: "new-password", placeholder: "Придумай пароль" %>
        <%= render "shared/password_field", form: form, name: :password_confirmation, label: "Повторите пароль", autocomplete: "new-password", placeholder: "Ещё раз пароль" %>
        <button class="primary" type="submit">Создать аккаунт <%= render "shared/arrow" %></button>
      <% end %>
      <p class="form-bottom">Уже есть аккаунт? <%= link_to "Войти", new_session_path, class: "text-link" %></p>
    </div>
  </section>
</main>
