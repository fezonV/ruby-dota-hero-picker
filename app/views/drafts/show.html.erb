<% content_for :title, "#{@draft.title} — Aegis Draft" %>
<main class="draft-layout" data-controller="live-draft" data-live-draft-url-value="<%= draft_path(@draft) %>"
  data-action="draft:changed->live-draft#refresh turbo:frame-load->live-draft#loaded turbo:submit-start->live-draft#submitStarted turbo:submit-end->live-draft#submitEnded turbo:fetch-request-error->live-draft#failed turbo:frame-missing->live-draft#missing">
  <%= turbo_stream_from @draft, channel: "DraftUpdatesChannel", data: { draft_id: @draft.id, live_draft_target: "source" } %>
  <%= link_to "Мои драфты", drafts_path, class: "text-link" %>
  <div class="draft-heading editor-heading">
    <div><h1><%= @draft.title %></h1><p>Выбери сторону и добавь героя в первое свободное место.</p></div>
    <span class="component-meta">Состав сохраняется после каждого действия</span>
  </div>
  <p class="component-meta" role="status" data-live-draft-target="status">Подключаем синхронизацию между вкладками</p>
  <div id="<%= dom_id(@draft, :feedback) %>"><%= render "drafts/feedback" %></div>
  <%= turbo_frame_tag dom_id(@draft, :editor), data: { live_draft_target: "frame" } do %>
    <%= render "drafts/editor" %>
  <% end %>
</main>
